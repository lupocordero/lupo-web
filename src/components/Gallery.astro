---
export interface Props {
  images: { src: string; alt: string }[];
}

const { images } = Astro.props;
---

{images.length > 0 && (
  <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:gap-4">
    {images.map((img, i) => (
      <div class={`overflow-hidden rounded-xl bg-sand ${i === 0 ? 'col-span-2 row-span-2 sm:col-span-2' : ''}`}>
        <img
          src={img.src}
          alt={img.alt}
          loading="lazy"
          decoding="async"
          width="800"
          height="600"
          class="h-full w-full object-cover"
        />
      </div>
    ))}
  </div>
)}
