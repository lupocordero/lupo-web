---
export interface Props {
  images: { src: string; alt: string }[];
}

const { images } = Astro.props;
---

{images.length > 0 && (
  <div class="columns-2 gap-1 md:columns-3" data-reveal>
    {images.map((img) => (
      <div class="mb-1 overflow-hidden break-inside-avoid bg-line">
        <img
          src={img.src}
          alt={img.alt}
          loading="lazy"
          decoding="async"
          width="800"
          height="600"
          class="w-full object-cover transition duration-700 hover:scale-105"
        />
      </div>
    ))}
  </div>
)}
