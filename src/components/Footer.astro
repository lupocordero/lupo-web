---
import { SITE, NAV, SERVICE_META, LOCATION_META } from '../data/site';
import { type Lang, SERVICE_KEYS, LOCATION_KEYS, serviceHref, locationHref, pageHref, blogIndexHref } from '../data/routes';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const nav = NAV[lang];
const year = new Date().getFullYear();
---

<footer class="border-t border-line">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 py-14 sm:grid-cols-2 md:px-8 lg:grid-cols-4">
    <div>
      <p class="font-serif text-lg">{SITE.brand}</p>
      <p class="mt-2 text-sm text-ink/60">{SITE.serviceArea}</p>
      <div class="mt-5 flex flex-col gap-1.5 text-sm">
        <a href={SITE.whatsappLink} class="link-arrow w-fit">WhatsApp</a>
        <a href={`mailto:${SITE.email}`} class="text-ink/70 hover:text-rust">{SITE.email}</a>
        <a href={SITE.instagramUrl} class="text-ink/70 hover:text-rust">{SITE.instagram}</a>
      </div>
    </div>

    <div>
      <p class="eyebrow mb-4">{nav.work}</p>
      <ul class="space-y-2 text-sm">
        {SERVICE_KEYS.map((key) => (
          <li><a href={serviceHref(key, lang)} class="text-ink/70 hover:text-rust">{SERVICE_META[key][lang]}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <p class="eyebrow mb-4">{nav.areas}</p>
      <ul class="space-y-2 text-sm">
        {LOCATION_KEYS.map((key) => (
          <li><a href={locationHref(key, lang)} class="text-ink/70 hover:text-rust">{LOCATION_META[key][lang]}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <p class="eyebrow mb-4">{SITE.brand}</p>
      <ul class="space-y-2 text-sm">
        <li><a href={pageHref('about', lang)} class="text-ink/70 hover:text-rust">{nav.about}</a></li>
        <li><a href={blogIndexHref(lang)} class="text-ink/70 hover:text-rust">{nav.journal}</a></li>
        <li><a href={pageHref('contact', lang)} class="text-ink/70 hover:text-rust">{nav.contact}</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-line px-5 py-5 text-center text-xs text-ink/40 md:px-8">
    © {year} {SITE.brand}
  </div>
</footer>
