---
import { SERVICE_META } from '../data/site';
import { serviceHref, type Lang, type ServiceKey } from '../data/routes';

export interface Props {
  serviceKey: ServiceKey;
  lang: Lang;
  blurb: string;
}

const { serviceKey, lang, blurb } = Astro.props;
const meta = SERVICE_META[serviceKey];
---

<a
  href={serviceHref(serviceKey, lang)}
  class="group flex flex-col gap-2 border-t border-line py-8 first:border-t-0 md:flex-row md:items-baseline md:justify-between md:gap-10"
>
  <h3 class="font-serif text-2xl transition group-hover:text-rust md:w-1/3">{meta[lang]}</h3>
  <p class="text-ink/60 md:w-2/3">{blurb}</p>
</a>
