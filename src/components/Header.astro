---
import { SITE, NAV, SERVICE_META } from '../data/site';
import {
  type Lang,
  LANGS,
  LANG_LABELS,
  serviceHref,
  pageHref,
  blogIndexHref,
  localePath,
} from '../data/routes';

export interface Props {
  lang: Lang;
  alternates: Partial<Record<Lang, string>>;
}

const { lang, alternates } = Astro.props;
const nav = NAV[lang];
const home = localePath(lang, '');

const LANG_CODE: Record<Lang, string> = { es: 'ES', de: 'DE', en: 'EN' };
const otherLangs = LANGS.filter((l) => l !== lang);
---

<header class="sticky top-0 z-40 border-b border-paper/15 bg-ink text-paper">
  <div class="mx-auto flex max-w-[1600px] flex-wrap items-center justify-between gap-4 px-5 py-4 md:px-8">
    <a href={home} class="shrink-0">
      <img src="/images/lupo-logo-pink.png" alt={SITE.brand} class="h-7 w-auto md:h-8" width="1272" height="263" />
    </a>

    <nav class="hidden items-center gap-x-7 font-mono text-xs uppercase tracking-widest2 lg:flex">
      <a href={serviceHref('events', lang)} class="border-b border-transparent pb-1 text-paper/90 transition hover:border-rust hover:text-rust">
        {SERVICE_META.events[lang]}
      </a>
      <a href={serviceHref('portraits', lang)} class="border-b border-transparent pb-1 text-paper/90 transition hover:border-rust hover:text-rust">
        {SERVICE_META.portraits[lang]}
      </a>
      <a href={serviceHref('elopement', lang)} class="border-b border-transparent pb-1 text-paper/90 transition hover:border-rust hover:text-rust">
        {SERVICE_META.elopement[lang]}
      </a>
      <a href={serviceHref('portraittour', lang)} class="border-b border-transparent pb-1 text-paper/90 transition hover:border-rust hover:text-rust">
        {SERVICE_META.portraittour[lang]}
      </a>

      <a href={blogIndexHref(lang)} class="border-b border-transparent pb-1 text-paper/90 transition hover:border-rust hover:text-rust">{nav.journal}</a>
      <a href={pageHref('about', lang)} class="border-b border-transparent pb-1 text-paper/90 transition hover:border-rust hover:text-rust">{nav.about}</a>
    </nav>

    <div class="flex items-center gap-3">
      <div class="relative" data-lang-switch>
        <button
          type="button"
          data-lang-toggle
          aria-expanded="false"
          aria-haspopup="true"
          aria-label={LANG_LABELS[lang]}
          class="flex h-8 items-center justify-center px-1 font-mono text-xs uppercase tracking-widest2 text-paper/90 transition hover:text-rust"
        >
          {LANG_CODE[lang]}
        </button>
        <div
          data-lang-options
          class="absolute right-0 top-full z-10 mt-2 hidden flex-col gap-1 rounded-lg border border-paper/15 bg-ink p-1.5 shadow-lg"
        >
          {otherLangs.map((l) => (
            <a
              href={alternates[l] ?? localePath(l, '')}
              aria-label={LANG_LABELS[l]}
              class="flex h-8 items-center justify-center px-2 font-mono text-xs uppercase tracking-widest2 text-paper/90 transition hover:text-rust"
            >
              {LANG_CODE[l]}
            </a>
          ))}
        </div>
      </div>

      <a href={pageHref('contact', lang)} class="link-arrow hidden text-sm !border-paper text-paper hover:!border-rust hover:text-rust sm:inline-flex">{nav.contact}</a>

      <button
        type="button"
        id="menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={nav.home}
        class="flex h-9 w-9 items-center justify-center text-paper lg:hidden"
      >
        <svg id="icon-open" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <svg id="icon-close" class="hidden" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="5" y1="5" x2="19" y2="19"></line>
          <line x1="19" y1="5" x2="5" y2="19"></line>
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" class="hidden flex-col items-end gap-1 border-t border-paper/15 px-5 py-4 text-right font-mono text-sm uppercase tracking-widest2 lg:hidden">
    <a href={serviceHref('events', lang)} class="py-2 text-paper/90">{SERVICE_META.events[lang]}</a>
    <a href={serviceHref('portraits', lang)} class="py-2 text-paper/90">{SERVICE_META.portraits[lang]}</a>
    <a href={serviceHref('elopement', lang)} class="py-2 text-paper/90">{SERVICE_META.elopement[lang]}</a>
    <a href={serviceHref('portraittour', lang)} class="py-2 text-paper/90">{SERVICE_META.portraittour[lang]}</a>
    <a href={blogIndexHref(lang)} class="py-2 text-paper/90">{nav.journal}</a>
    <a href={pageHref('about', lang)} class="py-2 text-paper/90">{nav.about}</a>
    <a href={pageHref('contact', lang)} class="link-arrow mt-3 w-fit !border-paper text-paper sm:hidden">{nav.contact}</a>
  </nav>
</header>

<script>
  const btn = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  btn?.addEventListener('click', () => {
    const isOpen = menu?.classList.contains('flex');
    menu?.classList.toggle('hidden');
    menu?.classList.toggle('flex');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
    btn.setAttribute('aria-expanded', String(!isOpen));
  });

  // Flag language switcher: click the current flag to reveal the other
  // languages; click elsewhere (or pick one) to close it again.
  document.querySelectorAll('[data-lang-switch]').forEach((wrap) => {
    const toggle = wrap.querySelector('[data-lang-toggle]');
    const panel = wrap.querySelector('[data-lang-options]');
    toggle?.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = !panel?.classList.contains('hidden');
      document.querySelectorAll('[data-lang-options]').forEach((p) => {
        p.classList.add('hidden');
        p.classList.remove('flex');
      });
      if (!isOpen) {
        panel?.classList.remove('hidden');
        panel?.classList.add('flex');
      }
      toggle.setAttribute('aria-expanded', String(!isOpen));
    });
  });

  document.addEventListener('click', () => {
    document.querySelectorAll('[data-lang-options]').forEach((p) => {
      p.classList.add('hidden');
      p.classList.remove('flex');
    });
    document.querySelectorAll('[data-lang-toggle]').forEach((t) => t.setAttribute('aria-expanded', 'false'));
  });
</script>
