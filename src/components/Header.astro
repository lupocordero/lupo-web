---
import { NAV, SITE, SERVICE_META, LOCATION_META } from '../data/site';
import {
  type Lang,
  LANGS,
  LANG_LABELS,
  SERVICE_KEYS,
  LOCATION_KEYS,
  serviceHref,
  locationHref,
  pageHref,
  blogIndexHref,
  localePath,
} from '../data/routes';

export interface Props {
  lang: Lang;
  alternates: Partial<Record<Lang, string>>;
}

const { lang, alternates } = Astro.props;
const nav = NAV[lang];
const home = localePath(lang, '');
---

<header class="sticky top-0 z-50 border-b border-sand bg-paper/95 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3">
    <a href={home} class="font-serif text-xl font-bold tracking-tight">{SITE.brand}</a>

    <nav class="hidden items-center gap-6 text-sm font-medium lg:flex">
      <a href={home} class="hover:text-clay">{nav.home}</a>

      <div class="group relative">
        <button class="hover:text-clay">{nav.services}</button>
        <div class="invisible absolute left-0 top-full w-56 rounded-lg border border-sand bg-paper p-2 opacity-0 shadow-lg transition group-hover:visible group-hover:opacity-100">
          {SERVICE_KEYS.map((key) => (
            <a href={serviceHref(key, lang)} class="block rounded px-3 py-2 hover:bg-sand">
              {SERVICE_META[key].icon} {SERVICE_META[key][lang]}
            </a>
          ))}
        </div>
      </div>

      <a href={`${home}#portfolio`} class="hover:text-clay">{nav.portfolio}</a>

      <div class="group relative">
        <button class="hover:text-clay">{nav.areas}</button>
        <div class="invisible absolute left-0 top-full w-44 rounded-lg border border-sand bg-paper p-2 opacity-0 shadow-lg transition group-hover:visible group-hover:opacity-100">
          {LOCATION_KEYS.map((key) => (
            <a href={locationHref(key, lang)} class="block rounded px-3 py-2 hover:bg-sand">
              {LOCATION_META[key][lang]}
            </a>
          ))}
        </div>
      </div>

      <a href={pageHref('about', lang)} class="hover:text-clay">{nav.about}</a>
      <a href={blogIndexHref(lang)} class="hover:text-clay">{nav.blog}</a>
      <a href={pageHref('contact', lang)} class="hover:text-clay">{nav.contact}</a>
    </nav>

    <div class="flex items-center gap-3">
      <div class="hidden items-center gap-1 text-xs font-semibold uppercase tracking-wide sm:flex">
        {LANGS.map((l) => (
          <a
            href={alternates[l] ?? localePath(l, '')}
            aria-current={l === lang ? 'page' : undefined}
            class={`rounded px-2 py-1 ${l === lang ? 'bg-ink text-paper' : 'hover:bg-sand'}`}
            title={LANG_LABELS[l]}
          >
            {l.toUpperCase()}
          </a>
        ))}
      </div>
      <a
        href={SITE.whatsappLink}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-full bg-olive px-4 py-2 text-sm font-semibold text-paper hover:bg-ink"
      >
        {nav.cta}
      </a>
    </div>
  </div>
</header>
