---
import { SITE, NAV, LOCATION_META, SERVICE_META } from '../data/site';
import {
  type Lang,
  LANGS,
  serviceHref,
  locationHref,
  pageHref,
  blogIndexHref,
  localePath,
  LOCATION_KEYS,
} from '../data/routes';

export interface Props {
  lang: Lang;
  alternates: Partial<Record<Lang, string>>;
}

const { lang, alternates } = Astro.props;
const nav = NAV[lang];
const home = localePath(lang, '');
---

<header class="border-b border-line">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-5 py-5 md:px-8">
    <a href={home} class="font-serif text-xl tracking-tight">{SITE.brand}</a>

    <nav class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm">
      <a href={serviceHref('elopement', lang)} class="border-b border-transparent pb-0.5 hover:border-ink">
        {SERVICE_META.elopement[lang]}
      </a>
      <a href={serviceHref('portraits', lang)} class="border-b border-transparent pb-0.5 hover:border-ink">
        {SERVICE_META.portraits[lang]}
      </a>

      <div class="group relative">
        <button class="border-b border-transparent pb-0.5 hover:border-ink">{nav.areas}</button>
        <div class="invisible absolute left-0 top-full z-10 min-w-[8rem] pt-3 opacity-0 transition group-hover:visible group-hover:opacity-100">
          <div class="border border-line bg-paper py-2">
            {LOCATION_KEYS.map((key) => (
              <a href={locationHref(key, lang)} class="block px-4 py-1.5 text-sm hover:text-rust">
                {LOCATION_META[key][lang]}
              </a>
            ))}
          </div>
        </div>
      </div>

      <a href={serviceHref('realestate', lang)} class="border-b border-transparent pb-0.5 hover:border-ink">
        {nav.commercial}
      </a>
      <a href={blogIndexHref(lang)} class="border-b border-transparent pb-0.5 hover:border-ink">{nav.journal}</a>
      <a href={pageHref('about', lang)} class="border-b border-transparent pb-0.5 hover:border-ink">{nav.about}</a>
    </nav>

    <div class="flex items-center gap-4 text-sm">
      <div class="flex items-center gap-1 text-xs uppercase tracking-wide text-ink/50">
        {LANGS.map((l, i) => (
          <>
            {i > 0 && <span>/</span>}
            <a
              href={alternates[l] ?? localePath(l, '')}
              aria-current={l === lang ? 'page' : undefined}
              class={l === lang ? 'text-ink' : 'hover:text-ink'}
            >
              {l.toUpperCase()}
            </a>
          </>
        ))}
      </div>
      <a href={pageHref('contact', lang)} class="link-arrow">{nav.contact}</a>
    </div>
  </div>
</header>
