---
import ContactForm from './ContactForm.astro';
import { UI } from '../data/site';
import type { Lang } from '../data/routes';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = UI[lang];
---

<dialog id="contact-modal" class="m-auto w-[min(92vw,32rem)] rounded-none border border-line bg-paper p-0 backdrop:bg-ink/60">
  <div class="relative p-7 pt-10 md:p-9 md:pt-12">
    <button
      type="button"
      data-close-contact-modal
      aria-label={ui.modalClose}
      class="absolute right-5 top-5 text-lg leading-none text-ink/40 transition hover:text-rust"
    >
      ✕
    </button>
    <h2 class="pr-8 font-display text-2xl font-bold text-rust">{ui.checkAvailability}</h2>
    <div class="mt-6">
      <ContactForm lang={lang} idPrefix="modal" accent="rust" />
    </div>
  </div>
</dialog>
