---
import { UI } from '../data/site';
import type { Lang } from '../data/routes';

export interface Props {
  lang: Lang;
  faqs: { q: string; a: string }[];
}

const { lang, faqs } = Astro.props;
const ui = UI[lang];
---

{faqs.length > 0 && (
  <section class="mx-auto max-w-3xl">
    <h2 class="mb-6 text-2xl font-semibold md:text-3xl">{ui.faqTitle}</h2>
    <div class="divide-y divide-sand rounded-2xl border border-sand">
      {faqs.map((faq) => (
        <details class="group p-5">
          <summary class="cursor-pointer list-none font-medium marker:content-none">
            <span class="flex items-center justify-between gap-4">
              {faq.q}
              <span class="shrink-0 text-clay transition group-open:rotate-45">+</span>
            </span>
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-ink/75">{faq.a}</p>
        </details>
      ))}
    </div>
  </section>
)}
