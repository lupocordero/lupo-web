---
import { UI } from '../data/site';
import type { Lang } from '../data/routes';

export interface Props {
  lang: Lang;
  faqs: { q: string; a: string }[];
}

const { lang, faqs } = Astro.props;
const ui = UI[lang];
---

{faqs.length > 0 && (
  <section class="max-w-[62ch]">
    <p class="eyebrow mb-6">{ui.faqTitle}</p>
    <div class="divide-y divide-line border-t border-line">
      {faqs.map((faq) => (
        <details class="group py-5">
          <summary class="cursor-pointer list-none font-serif text-lg marker:content-none">
            <span class="flex items-start justify-between gap-4">
              {faq.q}
              <span class="mt-1 shrink-0 text-ink/40 transition group-open:rotate-45">+</span>
            </span>
          </summary>
          <p class="mt-3 max-w-[58ch] text-[0.95rem] leading-relaxed text-ink/70">{faq.a}</p>
        </details>
      ))}
    </div>
  </section>
)}
