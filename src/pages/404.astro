---
import Layout from '../layouts/Layout.astro';
---

<Layout
  lang="en"
  title="Page not found | Lupo Photography"
  description="This page could not be found."
  path="/404"
  alternates={{ en: '/en' }}
  noindex={true}
>
  <div class="mx-auto max-w-xl px-5 py-32 text-center">
    <h1 class="font-serif text-4xl">404</h1>
    <p class="mt-4 text-ink/60">Sorry, this page doesn't exist. Head back to the homepage.</p>
    <a href="/es" class="link-arrow mt-8 text-lg">
      Go home →
    </a>
  </div>
</Layout>
