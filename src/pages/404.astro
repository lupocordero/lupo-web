---
import Layout from '../layouts/Layout.astro';
---

<Layout
  lang="en"
  title="Page not found | Lupo Photography"
  description="This page could not be found."
  path="/404"
  alternates={{ en: '/en' }}
  noindex={true}
>
  <div class="mx-auto max-w-xl px-4 py-24 text-center">
    <h1 class="text-4xl font-bold">404</h1>
    <p class="mt-4 text-ink/70">Sorry, this page doesn't exist. Head back to the homepage.</p>
    <a href="/es" class="mt-6 inline-block rounded-full bg-ink px-6 py-3 font-semibold text-paper hover:bg-clay">
      Go home →
    </a>
  </div>
</Layout>
