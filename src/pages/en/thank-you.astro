---
import Layout from '../../layouts/Layout.astro';
import WhatsAppCTA from '../../components/WhatsAppCTA.astro';
---

<Layout
  lang="en"
  title="Message sent | Lupo Photographer Mallorca"
  description="Thanks for reaching out — Lupo replies the same day."
  path="/en/thank-you"
  alternates={{ es: '/es/gracias', de: '/de/danke', en: '/en/thank-you' }}
  noindex={true}
>
  <div class="mx-auto max-w-xl px-5 py-24 text-center md:py-32">
    <p class="eyebrow mb-4 text-ink/50">Message sent</p>
    <h1 class="font-display text-display-2 font-bold">Thank you!</h1>
    <p class="mt-5 text-lg text-ink/60">
      Your message just landed in my inbox. I'll get back to you the same day with availability and a quote.
    </p>
    <a href="/en" class="link-arrow mt-10 text-lg">
      Back to home →
    </a>
  </div>

  <WhatsAppCTA
    lang="en"
    compact={true}
    heading="Rather talk now?"
    body="Message me directly on WhatsApp and we'll pick it up from there."
  />
</Layout>
