---
import Layout from '../../layouts/Layout.astro';
import PrivacyPolicyContent from '../../components/PrivacyPolicyContent.astro';
import { PRIVACY_POLICY_TEXT } from '../../data/privacyPolicy';

const text = PRIVACY_POLICY_TEXT.en;
---

<Layout
  lang="en"
  title={text.metaTitle}
  description={text.metaDescription}
  path="/en/privacy-policy"
  alternates={{ es: '/es/privacidad', de: '/de/datenschutz', en: '/en/privacy-policy' }}
>
  <PrivacyPolicyContent lang="en" />
</Layout>
