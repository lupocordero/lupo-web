---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import WhatsAppCTA from '../../components/WhatsAppCTA.astro';
import {
  LANGS,
  type Lang,
  SERVICE_KEYS,
  SERVICE_TIER,
  LOCATION_KEYS,
  serviceHref,
  locationHref,
  localePath,
} from '../../data/routes';
import { SITE, UI, SERVICE_META, LOCATION_META, HOME_SERVICE_BLURBS } from '../../data/site';
import { localBusinessSchema } from '../../data/schema';

export async function getStaticPaths() {
  const pages = await getCollection('pages', (p) => p.data.pageKey === 'home');
  return pages.map((entry) => ({
    params: { lang: entry.data.lang },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const lang = entry.data.lang as Lang;
const ui = UI[lang];

const coreServices = SERVICE_KEYS.filter((k) => SERVICE_TIER[k] === 'core');
const secondaryServices = SERVICE_KEYS.filter((k) => SERVICE_TIER[k] === 'secondary');
const commercialServices = SERVICE_KEYS.filter((k) => SERVICE_TIER[k] === 'commercial');

const alternates: Partial<Record<Lang, string>> = {};
for (const l of LANGS) alternates[l] = localePath(l, '');

const path = localePath(lang, '');
---

<Layout
  lang={lang}
  title={entry.data.seoTitle}
  description={entry.data.metaDescription}
  path={path}
  alternates={alternates}
  ogImage={entry.data.heroImage}
  jsonLd={[localBusinessSchema()]}
>
  <section class="relative">
    {entry.data.heroImage && (
      <div class="h-[78vh] min-h-[460px] w-full overflow-hidden bg-line">
        <img
          src={entry.data.heroImage}
          alt={entry.data.heroImageAlt}
          class="h-full w-full object-cover"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    )}
  </section>

  <section class="mx-auto max-w-3xl px-5 py-16 text-center md:px-8 md:py-20">
    <h1 class="font-serif text-4xl leading-tight md:text-5xl">{entry.data.h1}</h1>
    <p class="mx-auto mt-5 max-w-xl text-lg text-ink/60">{entry.data.subtitle}</p>
    <a href={SITE.whatsappLink} target="_blank" rel="noopener noreferrer" class="link-arrow mt-8 text-lg">
      {ui.ctaButton} →
    </a>
  </section>

  <section class="mx-auto max-w-3xl px-5 pb-16 md:px-8">
    <div class="prose-lupo mx-auto">
      <Content />
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-5 py-16 md:px-8">
    <p class="eyebrow mb-6">{ui.servicesHeading}</p>
    <div>
      {coreServices.map((key) => (
        <ServiceCard serviceKey={key} lang={lang} blurb={HOME_SERVICE_BLURBS[key][lang]} />
      ))}
    </div>

    {secondaryServices.length > 0 && (
      <div class="mt-10 border-t border-line pt-6">
        <p class="eyebrow mb-4">{ui.secondaryHeading}</p>
        {secondaryServices.map((key) => (
          <ServiceCard serviceKey={key} lang={lang} blurb={HOME_SERVICE_BLURBS[key][lang]} />
        ))}
      </div>
    )}
  </section>

  {commercialServices.length > 0 && (
    <section class="border-t border-line bg-ink py-16 text-paper">
      <div class="mx-auto max-w-4xl px-5 md:px-8">
        <p class="eyebrow mb-6 text-paper/50">{ui.commercialHeading}</p>
        {commercialServices.map((key) => (
          <a
            href={serviceHref(key, lang)}
            class="group flex flex-col gap-2 border-t border-paper/20 py-8 first:border-t-0 md:flex-row md:items-baseline md:justify-between md:gap-10"
          >
            <h3 class="font-serif text-2xl transition group-hover:text-rust md:w-1/3">{SERVICE_META[key][lang]}</h3>
            <p class="text-paper/60 md:w-2/3">{HOME_SERVICE_BLURBS[key][lang]}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="mx-auto max-w-4xl px-5 py-16 md:px-8">
    <p class="eyebrow mb-6">{ui.areasWeWork}</p>
    <div class="flex flex-wrap gap-x-8 gap-y-3">
      {LOCATION_KEYS.map((key) => (
        <a href={locationHref(key, lang)} class="link-arrow">
          {LOCATION_META[key][lang]}
        </a>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-5 pb-16 md:px-8">
    <WhatsAppCTA lang={lang} />
  </section>
</Layout>
