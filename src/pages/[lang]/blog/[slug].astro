---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import WhatsAppCTA from '../../../components/WhatsAppCTA.astro';
import ServiceCard from '../../../components/ServiceCard.astro';
import {
  LANGS,
  type Lang,
  type BlogPostKey,
  blogPostHref,
  locationHref,
  type ServiceKey,
  type LocationKey,
} from '../../../data/routes';
import { UI, LOCATION_META, HOME_SERVICE_BLURBS } from '../../../data/site';
import { articleSchema, breadcrumbSchema, localBusinessSchema } from '../../../data/schema';
import { SITE_URL } from '../../../../astro.config.mjs';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((entry) => ({
    params: { lang: entry.data.lang, slug: entry.data.pageSlug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const lang = entry.data.lang as Lang;
const ui = UI[lang];
const postKey = entry.data.postKey as BlogPostKey;

const alternates: Partial<Record<Lang, string>> = {};
for (const l of LANGS) alternates[l] = blogPostHref(postKey, l);

const path = blogPostHref(postKey, lang);

const jsonLd = [
  localBusinessSchema(),
  articleSchema({
    headline: entry.data.h1,
    description: entry.data.metaDescription,
    url: `${SITE_URL}${path}`,
    image: entry.data.heroImage,
    datePublished: entry.data.publishDate.toISOString(),
    lang,
  }),
  breadcrumbSchema([{ name: entry.data.h1, url: path }]),
];

const relatedServices = (entry.data.relatedServiceKeys ?? []) as ServiceKey[];
const relatedLocations = (entry.data.relatedLocationKeys ?? []) as LocationKey[];

const dateLocale: Record<Lang, string> = { es: 'es-ES', de: 'de-DE', en: 'en-GB' };
---

<Layout
  lang={lang}
  title={entry.data.seoTitle}
  description={entry.data.metaDescription}
  path={path}
  alternates={alternates}
  ogImage={entry.data.heroImage}
  jsonLd={jsonLd}
>
  <article>
    <div class="relative h-[46vh] min-h-[300px] w-full overflow-hidden bg-ink">
      <div class="absolute inset-0" data-parallax="0.35">
        <img src={entry.data.heroImage} alt={entry.data.heroImageAlt} class="h-[130%] w-full object-cover opacity-80" loading="eager" />
      </div>
      <div class="absolute inset-0 bg-gradient-to-t from-ink/70 via-ink/5 to-transparent"></div>
      <div class="relative flex h-full flex-col justify-end px-5 pb-10 md:px-8 md:pb-14">
        <p class="eyebrow mb-3 text-paper/60">
          {entry.data.publishDate.toLocaleDateString(dateLocale[lang], { year: 'numeric', month: 'long', day: 'numeric' })}
        </p>
        <h1 class="max-w-3xl font-sans text-display-2 font-bold text-paper">{entry.data.h1}</h1>
      </div>
    </div>

    <div class="mx-auto max-w-3xl px-5 py-14 md:px-8">
      <div class="prose-lupo mt-2" data-reveal>
        <Content />
      </div>

      {relatedServices.length > 0 && (
        <div class="mt-14 border-t border-line pt-8">
          <p class="eyebrow mb-4">{ui.relatedPosts}</p>
          <div>
            {relatedServices.map((key) => (
              <ServiceCard serviceKey={key} lang={lang} blurb={HOME_SERVICE_BLURBS[key][lang]} />
            ))}
          </div>
          {relatedLocations.length > 0 && (
            <div class="mt-6 flex flex-wrap gap-x-8 gap-y-3">
              {relatedLocations.map((key) => (
                <a href={locationHref(key, lang)} class="link-arrow">
                  {LOCATION_META[key][lang]}
                </a>
              ))}
            </div>
          )}
        </div>
      )}

      <div class="mt-14">
        <WhatsAppCTA lang={lang} />
      </div>
    </div>
  </article>
</Layout>
