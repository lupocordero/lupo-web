---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import { LANGS, type Lang, blogIndexHref, blogPostHref, type BlogPostKey, localePath } from '../../../data/routes';
import { UI } from '../../../data/site';
import { localBusinessSchema } from '../../../data/schema';

export async function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const ui = UI[lang];

const allPosts = await getCollection('blog', (p) => p.data.lang === lang);
const posts = allPosts.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const alternates: Partial<Record<Lang, string>> = {};
for (const l of LANGS) alternates[l] = blogIndexHref(l);

const titles: Record<Lang, string> = {
  es: 'Diario | Fotógrafo en Mallorca – Lupo',
  de: 'Journal | Fotograf auf Mallorca – Lupo',
  en: 'Journal | Mallorca Photographer – Lupo',
};
const descriptions: Record<Lang, string> = {
  es: 'Guías y notas sobre elopements y retratos en Mallorca: mejores ubicaciones, qué llevar y cómo planificar tu sesión.',
  de: 'Guides und Notizen zu Elopements und Porträts auf Mallorca: beste Orte, was ihr mitbringen solltet und wie ihr euer Shooting plant.',
  en: 'Guides and notes on elopements and portraits in Mallorca: best locations, what to bring and how to plan your session.',
};

const dateLocale: Record<Lang, string> = { es: 'es-ES', de: 'de-DE', en: 'en-GB' };
---

<Layout
  lang={lang}
  title={titles[lang]}
  description={descriptions[lang]}
  path={blogIndexHref(lang)}
  alternates={alternates}
  jsonLd={[localBusinessSchema()]}
>
  <div class="mx-auto max-w-4xl px-5 py-16 md:px-8">
    <h1 class="font-serif text-3xl md:text-4xl">{ui.blogListTitle}</h1>
    <div class="mt-12">
      {posts.map((post) => (
        <a
          href={blogPostHref(post.data.postKey as BlogPostKey, lang)}
          class="group flex flex-col gap-5 border-t border-line py-8 first:border-t-0 md:flex-row md:gap-10"
        >
          <div class="aspect-[4/3] w-full overflow-hidden bg-line md:w-1/3">
            <img
              src={post.data.heroImage}
              alt={post.data.heroImageAlt}
              class="h-full w-full object-cover transition group-hover:scale-105"
              loading="lazy"
            />
          </div>
          <div class="md:w-2/3">
            <p class="eyebrow mb-2">
              {post.data.publishDate.toLocaleDateString(dateLocale[lang], { year: 'numeric', month: 'long', day: 'numeric' })}
            </p>
            <h2 class="font-serif text-xl transition group-hover:text-rust">{post.data.h1}</h2>
            <p class="mt-2 text-ink/60">{post.data.excerpt}</p>
            <span class="link-arrow mt-4 text-sm">{ui.readMore} →</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</Layout>
