---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import { LANGS, type Lang, blogIndexHref, blogPostHref, type BlogPostKey, localePath } from '../../../data/routes';
import { UI } from '../../../data/site';
import { localBusinessSchema } from '../../../data/schema';

export async function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const ui = UI[lang];

const allPosts = await getCollection('blog', (p) => p.data.lang === lang);
const posts = allPosts.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const alternates: Partial<Record<Lang, string>> = {};
for (const l of LANGS) alternates[l] = blogIndexHref(l);

const titles: Record<Lang, string> = {
  es: 'Blog y guías | Fotógrafo en Mallorca – Lupo',
  de: 'Blog & Guides | Fotograf auf Mallorca – Lupo',
  en: 'Blog & Guides | Mallorca Photographer – Lupo',
};
const descriptions: Record<Lang, string> = {
  es: 'Guías y consejos sobre fotografía de familia, elopements y bodas en Mallorca: mejores ubicaciones, qué llevar y cómo planificar tu sesión.',
  de: 'Guides und Tipps zu Familienfotos, Elopements und Hochzeiten auf Mallorca: beste Orte, was ihr mitbringen solltet und wie ihr euer Shooting plant.',
  en: 'Guides and tips on family photography, elopements and weddings in Mallorca: best locations, what to bring and how to plan your session.',
};

const dateLocale: Record<Lang, string> = { es: 'es-ES', de: 'de-DE', en: 'en-GB' };
---

<Layout
  lang={lang}
  title={titles[lang]}
  description={descriptions[lang]}
  path={blogIndexHref(lang)}
  alternates={alternates}
  jsonLd={[localBusinessSchema()]}
>
  <div class="mx-auto max-w-4xl px-4 py-14">
    <h1 class="text-3xl font-bold md:text-4xl">{ui.blogListTitle}</h1>
    <div class="mt-10 grid gap-8 sm:grid-cols-2">
      {posts.map((post) => (
        <a href={blogPostHref(post.data.postKey as BlogPostKey, lang)} class="group block overflow-hidden rounded-2xl border border-sand">
          <div class="aspect-[4/3] overflow-hidden bg-sand">
            <img
              src={post.data.heroImage}
              alt={post.data.heroImageAlt}
              class="h-full w-full object-cover transition group-hover:scale-105"
              loading="lazy"
            />
          </div>
          <div class="p-5">
            <p class="text-xs uppercase tracking-wide text-ink/50">
              {ui.publishedOn} {post.data.publishDate.toLocaleDateString(dateLocale[lang], { year: 'numeric', month: 'long', day: 'numeric' })}
            </p>
            <h2 class="mt-2 text-lg font-semibold group-hover:text-clay">{post.data.h1}</h2>
            <p class="mt-2 text-sm text-ink/70">{post.data.excerpt}</p>
            <span class="mt-3 inline-block text-sm font-semibold text-clay">{ui.readMore} →</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</Layout>
