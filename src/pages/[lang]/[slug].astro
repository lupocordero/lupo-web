---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Gallery from '../../components/Gallery.astro';
import FAQSection from '../../components/FAQSection.astro';
import WhatsAppCTA from '../../components/WhatsAppCTA.astro';
import {
  type Lang,
  LANGS,
  serviceHref,
  locationHref,
  pageHref,
  SERVICE_TIER,
  type ServiceKey,
  type LocationKey,
} from '../../data/routes';
import { SITE, UI, SERVICE_META, LOCATION_META } from '../../data/site';
import { serviceSchema, faqSchema, breadcrumbSchema, localBusinessSchema } from '../../data/schema';
import { SITE_URL } from '../../../astro.config.mjs';

type ServiceEntry = CollectionEntry<'services'>;
type LocationEntry = CollectionEntry<'locations'>;
type PageEntry = CollectionEntry<'pages'>;

type Props =
  | { type: 'service'; entry: ServiceEntry }
  | { type: 'location'; entry: LocationEntry }
  | { type: 'page'; entry: PageEntry };

export async function getStaticPaths() {
  const services = await getCollection('services');
  const locations = await getCollection('locations');
  const pages = (await getCollection('pages')).filter((p) => p.data.pageKey !== 'home');

  return [
    ...services.map((entry) => ({
      params: { lang: entry.data.lang, slug: entry.data.pageSlug },
      props: { type: 'service' as const, entry },
    })),
    ...locations.map((entry) => ({
      params: { lang: entry.data.lang, slug: entry.data.pageSlug },
      props: { type: 'location' as const, entry },
    })),
    ...pages.map((entry) => ({
      params: { lang: entry.data.lang, slug: entry.data.pageSlug },
      props: { type: 'page' as const, entry },
    })),
  ];
}

const { type, entry } = Astro.props as Props;
const { Content } = await entry.render();
const lang = entry.data.lang as Lang;
const ui = UI[lang];

let alternates: Partial<Record<Lang, string>> = {};
let jsonLd: Record<string, unknown>[] = [localBusinessSchema()];
let heroImage: string | undefined;
let heroImageAlt: string | undefined;
let isCommercial = false;

if (type === 'service') {
  const key = entry.data.serviceKey as ServiceKey;
  isCommercial = SERVICE_TIER[key] === 'commercial';
  for (const l of LANGS) alternates[l] = serviceHref(key, l);
  heroImage = entry.data.heroImage;
  heroImageAlt = entry.data.heroImageAlt;
  jsonLd.push(
    serviceSchema({
      name: entry.data.h1,
      description: entry.data.metaDescription,
      url: `${SITE_URL}${serviceHref(key, lang)}`,
      serviceType: SERVICE_META[key][lang],
      lang,
    })
  );
  const faq = faqSchema(entry.data.faqs);
  if (faq) jsonLd.push(faq);
  jsonLd.push(
    breadcrumbSchema([
      { name: ui.servicesHeading, url: pageHref('home', lang) },
      { name: entry.data.h1, url: serviceHref(key, lang) },
    ])
  );
} else if (type === 'location') {
  const key = entry.data.locationKey as LocationKey;
  for (const l of LANGS) alternates[l] = locationHref(key, l);
  heroImage = entry.data.heroImage;
  heroImageAlt = entry.data.heroImageAlt;
  jsonLd.push(
    serviceSchema({
      name: entry.data.h1,
      description: entry.data.metaDescription,
      url: `${SITE_URL}${locationHref(key, lang)}`,
      serviceType: `Photography in ${LOCATION_META[key][lang]}`,
      lang,
    })
  );
  const faq = faqSchema(entry.data.faqs);
  if (faq) jsonLd.push(faq);
  jsonLd.push(
    breadcrumbSchema([
      { name: ui.areasWeWork, url: pageHref('home', lang) },
      { name: entry.data.h1, url: locationHref(key, lang) },
    ])
  );
} else {
  const key = entry.data.pageKey as 'about' | 'contact';
  for (const l of LANGS) alternates[l] = pageHref(key, l);
  heroImage = entry.data.heroImage;
  heroImageAlt = entry.data.heroImageAlt;
  jsonLd.push(
    breadcrumbSchema([{ name: entry.data.h1, url: pageHref(key, lang) }])
  );
  if (key === 'contact') {
    jsonLd.push({
      '@context': 'https://schema.org',
      '@type': 'ContactPoint',
      contactType: 'customer service',
      telephone: SITE.whatsappNumber,
      email: SITE.email,
      areaServed: SITE.serviceArea,
      availableLanguage: ['Spanish', 'German', 'English'],
    });
  }
}

const path = `/${lang}/${entry.data.pageSlug}`;
---

<Layout
  lang={lang}
  title={entry.data.seoTitle}
  description={entry.data.metaDescription}
  path={path}
  alternates={alternates}
  ogImage={heroImage}
  jsonLd={jsonLd}
>
  {heroImage && (
    <div class="relative h-[56vh] min-h-[380px] w-full overflow-hidden bg-ink">
      <div class="absolute inset-0" data-parallax="0.35">
        <img src={heroImage} alt={heroImageAlt} class="h-[130%] w-full object-cover opacity-80" loading="eager" fetchpriority="high" />
      </div>
      <div class="absolute inset-0 bg-gradient-to-t from-ink/70 via-ink/5 to-transparent"></div>
      <div class="relative flex h-full flex-col justify-end px-5 pb-10 md:px-8 md:pb-14">
        {isCommercial && <p class="eyebrow mb-3 text-paper/60">{ui.commercialHeading}</p>}
        <h1 class="max-w-3xl font-sans text-display-2 font-bold text-paper">{entry.data.h1}</h1>
      </div>
    </div>
  )}

  <div class="mx-auto max-w-3xl px-5 py-14 md:px-8">
    {!heroImage && (
      <>
        {isCommercial && <p class="eyebrow mb-4">{ui.commercialHeading}</p>}
        <h1 class="font-sans text-display-2 font-bold">{entry.data.h1}</h1>
      </>
    )}
    {'subtitle' in entry.data && entry.data.subtitle && (
      <p class="mt-3 text-lg text-ink/60">{entry.data.subtitle}</p>
    )}

    <div class="prose-lupo mt-10" data-reveal>
      <Content />
    </div>

    {type !== 'page' && 'gallery' in entry.data && entry.data.gallery?.length > 0 && (
      <div class="my-12">
        <Gallery images={entry.data.gallery} />
      </div>
    )}

    {type === 'service' && 'areas' in entry.data && entry.data.areas?.length > 0 && (
      <div class="my-10 border-t border-line pt-6" data-reveal>
        <p class="eyebrow mb-2">{ui.areasWeWork}</p>
        <p class="text-sm text-ink/70">{entry.data.areas.join(' · ')}</p>
      </div>
    )}

    {type === 'page' && entry.data.pageKey === 'contact' && (
      <div class="my-12 grid gap-10 border-t border-line pt-10 md:grid-cols-2">
        <div>
          <p class="eyebrow mb-6">{ui.formSubmit}</p>
          <!-- Formspree placeholder: replace action with your Formspree endpoint, e.g. https://formspree.io/f/yourFormId -->
          <form action={`mailto:${SITE.email}`} method="POST" enctype="text/plain" class="space-y-5">
            <div>
              <label class="eyebrow mb-1 block" for="name">{ui.formName}</label>
              <input id="name" name="name" type="text" required class="w-full border-b border-line bg-transparent py-2 focus:border-ink focus:outline-none" />
            </div>
            <div>
              <label class="eyebrow mb-1 block" for="email">{ui.formEmail}</label>
              <input id="email" name="email" type="email" required class="w-full border-b border-line bg-transparent py-2 focus:border-ink focus:outline-none" />
            </div>
            <div>
              <label class="eyebrow mb-1 block" for="sessionType">{ui.formSessionType}</label>
              <input id="sessionType" name="sessionType" type="text" class="w-full border-b border-line bg-transparent py-2 focus:border-ink focus:outline-none" />
            </div>
            <div>
              <label class="eyebrow mb-1 block" for="message">{ui.formMessage}</label>
              <textarea id="message" name="message" rows="4" required class="w-full border-b border-line bg-transparent py-2 focus:border-ink focus:outline-none"></textarea>
            </div>
            <button type="submit" class="mt-2 w-full bg-ink py-3 font-sans font-semibold text-paper transition hover:bg-rust">
              {ui.formSubmit}
            </button>
          </form>
        </div>
        <div class="text-sm">
          <p class="eyebrow mb-2">WhatsApp</p>
          <a href={SITE.whatsappLink} class="link-arrow">{SITE.whatsappNumber}</a>
          <p class="eyebrow mb-2 mt-8">Email</p>
          <a href={`mailto:${SITE.email}`} class="link-arrow">{SITE.email}</a>
          <p class="eyebrow mb-2 mt-8">Instagram</p>
          <a href={SITE.instagramUrl} class="link-arrow">{SITE.instagram}</a>
          <p class="eyebrow mb-2 mt-8">{ui.areasWeWork}</p>
          <p class="text-ink/70">{SITE.serviceArea}</p>
        </div>
      </div>
    )}

    {'faqs' in entry.data && entry.data.faqs?.length > 0 && (
      <div class="my-12">
        <FAQSection lang={lang} faqs={entry.data.faqs} />
      </div>
    )}

    <div class="mt-12">
      <WhatsAppCTA lang={lang} />
    </div>
  </div>
</Layout>
