---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Gallery from '../../components/Gallery.astro';
import FAQSection from '../../components/FAQSection.astro';
import WhatsAppCTA from '../../components/WhatsAppCTA.astro';
import {
  type Lang,
  LANGS,
  serviceHref,
  locationHref,
  pageHref,
  type ServiceKey,
  type LocationKey,
} from '../../data/routes';
import { SITE, UI, SERVICE_META, LOCATION_META } from '../../data/site';
import { serviceSchema, faqSchema, breadcrumbSchema, localBusinessSchema } from '../../data/schema';
import { SITE_URL } from '../../../astro.config.mjs';

type ServiceEntry = CollectionEntry<'services'>;
type LocationEntry = CollectionEntry<'locations'>;
type PageEntry = CollectionEntry<'pages'>;

type Props =
  | { type: 'service'; entry: ServiceEntry }
  | { type: 'location'; entry: LocationEntry }
  | { type: 'page'; entry: PageEntry };

export async function getStaticPaths() {
  const services = await getCollection('services');
  const locations = await getCollection('locations');
  const pages = (await getCollection('pages')).filter((p) => p.data.pageKey !== 'home');

  return [
    ...services.map((entry) => ({
      params: { lang: entry.data.lang, slug: entry.data.pageSlug },
      props: { type: 'service' as const, entry },
    })),
    ...locations.map((entry) => ({
      params: { lang: entry.data.lang, slug: entry.data.pageSlug },
      props: { type: 'location' as const, entry },
    })),
    ...pages.map((entry) => ({
      params: { lang: entry.data.lang, slug: entry.data.pageSlug },
      props: { type: 'page' as const, entry },
    })),
  ];
}

const { type, entry } = Astro.props as Props;
const { Content } = await entry.render();
const lang = entry.data.lang as Lang;
const ui = UI[lang];

let alternates: Partial<Record<Lang, string>> = {};
let jsonLd: Record<string, unknown>[] = [localBusinessSchema()];
let heroImage: string | undefined;
let heroImageAlt: string | undefined;

if (type === 'service') {
  const key = entry.data.serviceKey as ServiceKey;
  for (const l of LANGS) alternates[l] = serviceHref(key, l);
  heroImage = entry.data.heroImage;
  heroImageAlt = entry.data.heroImageAlt;
  jsonLd.push(
    serviceSchema({
      name: entry.data.h1,
      description: entry.data.metaDescription,
      url: `${SITE_URL}${serviceHref(key, lang)}`,
      serviceType: SERVICE_META[key][lang],
      lang,
    })
  );
  const faq = faqSchema(entry.data.faqs);
  if (faq) jsonLd.push(faq);
  jsonLd.push(
    breadcrumbSchema([
      { name: ui.servicesHeading, url: pageHref('home', lang) },
      { name: entry.data.h1, url: serviceHref(key, lang) },
    ])
  );
} else if (type === 'location') {
  const key = entry.data.locationKey as LocationKey;
  for (const l of LANGS) alternates[l] = locationHref(key, l);
  heroImage = entry.data.heroImage;
  heroImageAlt = entry.data.heroImageAlt;
  jsonLd.push(
    serviceSchema({
      name: entry.data.h1,
      description: entry.data.metaDescription,
      url: `${SITE_URL}${locationHref(key, lang)}`,
      serviceType: `Photography in ${LOCATION_META[key][lang]}`,
      lang,
    })
  );
  const faq = faqSchema(entry.data.faqs);
  if (faq) jsonLd.push(faq);
  jsonLd.push(
    breadcrumbSchema([
      { name: ui.areasWeWork, url: pageHref('home', lang) },
      { name: entry.data.h1, url: locationHref(key, lang) },
    ])
  );
} else {
  const key = entry.data.pageKey as 'about' | 'contact';
  for (const l of LANGS) alternates[l] = pageHref(key, l);
  heroImage = entry.data.heroImage;
  heroImageAlt = entry.data.heroImageAlt;
  jsonLd.push(
    breadcrumbSchema([{ name: entry.data.h1, url: pageHref(key, lang) }])
  );
  if (key === 'contact') {
    jsonLd.push({
      '@context': 'https://schema.org',
      '@type': 'ContactPoint',
      contactType: 'customer service',
      telephone: SITE.whatsappNumber,
      email: SITE.email,
      areaServed: SITE.serviceArea,
      availableLanguage: ['Spanish', 'German', 'English'],
    });
  }
}

const path = `/${lang}/${entry.data.pageSlug}`;
---

<Layout
  lang={lang}
  title={entry.data.seoTitle}
  description={entry.data.metaDescription}
  path={path}
  alternates={alternates}
  ogImage={heroImage}
  jsonLd={jsonLd}
>
  {heroImage && (
    <div class="h-[42vh] min-h-[280px] w-full overflow-hidden bg-sand">
      <img src={heroImage} alt={heroImageAlt} class="h-full w-full object-cover" loading="eager" fetchpriority="high" />
    </div>
  )}

  <div class="mx-auto max-w-3xl px-4 py-12">
    <h1 class="text-3xl font-bold md:text-4xl">{entry.data.h1}</h1>
    {'subtitle' in entry.data && entry.data.subtitle && (
      <p class="mt-3 text-lg text-ink/70">{entry.data.subtitle}</p>
    )}

    <div class="prose-lupo mt-8">
      <Content />
    </div>

    {type !== 'page' && 'gallery' in entry.data && entry.data.gallery?.length > 0 && (
      <div class="my-10">
        <Gallery images={entry.data.gallery} />
      </div>
    )}

    {type === 'service' && 'areas' in entry.data && entry.data.areas?.length > 0 && (
      <div class="my-8 rounded-xl bg-sand/50 p-5">
        <p class="text-sm font-semibold uppercase tracking-wide text-ink/60">{ui.areasWeWork}</p>
        <p class="mt-2 text-sm">{entry.data.areas.join(' · ')}</p>
      </div>
    )}

    {type === 'page' && entry.data.pageKey === 'contact' && (
      <div class="my-10 grid gap-8 md:grid-cols-2">
        <div class="rounded-2xl border border-sand p-6">
          <h2 class="mb-4 text-xl font-semibold">{ui.formSubmit}</h2>
          <!-- Formspree placeholder: replace action with your Formspree endpoint, e.g. https://formspree.io/f/yourFormId -->
          <form action={`mailto:${SITE.email}`} method="POST" enctype="text/plain" class="space-y-4">
            <div>
              <label class="mb-1 block text-sm font-medium" for="name">{ui.formName}</label>
              <input id="name" name="name" type="text" required class="w-full rounded-lg border border-sand px-3 py-2" />
            </div>
            <div>
              <label class="mb-1 block text-sm font-medium" for="email">{ui.formEmail}</label>
              <input id="email" name="email" type="email" required class="w-full rounded-lg border border-sand px-3 py-2" />
            </div>
            <div>
              <label class="mb-1 block text-sm font-medium" for="sessionType">{ui.formSessionType}</label>
              <input id="sessionType" name="sessionType" type="text" class="w-full rounded-lg border border-sand px-3 py-2" />
            </div>
            <div>
              <label class="mb-1 block text-sm font-medium" for="message">{ui.formMessage}</label>
              <textarea id="message" name="message" rows="4" required class="w-full rounded-lg border border-sand px-3 py-2"></textarea>
            </div>
            <button type="submit" class="w-full rounded-full bg-ink px-6 py-3 font-semibold text-paper hover:bg-clay">
              {ui.formSubmit}
            </button>
          </form>
        </div>
        <div class="rounded-2xl bg-sand/40 p-6 text-sm">
          <p class="font-semibold">WhatsApp</p>
          <a href={SITE.whatsappLink} class="text-clay hover:underline">{SITE.whatsappNumber}</a>
          <p class="mt-4 font-semibold">Email</p>
          <a href={`mailto:${SITE.email}`} class="text-clay hover:underline">{SITE.email}</a>
          <p class="mt-4 font-semibold">Instagram</p>
          <a href={SITE.instagramUrl} class="text-clay hover:underline">{SITE.instagram}</a>
          <p class="mt-4 font-semibold">{ui.areasWeWork}</p>
          <p>{SITE.serviceArea}</p>
        </div>
      </div>
    )}

    {'faqs' in entry.data && entry.data.faqs?.length > 0 && (
      <div class="my-10">
        <FAQSection lang={lang} faqs={entry.data.faqs} />
      </div>
    )}

    <div class="mt-10">
      <WhatsAppCTA lang={lang} />
    </div>
  </div>
</Layout>
